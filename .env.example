# Copy this file to .env and fill in the empty values.
# .env is ignored by git. Never commit it.

# Nordavo helpdesk
HELPDESK_URL=https://nakywgkztvzkihdjnwbc.supabase.co/functions/v1/helpdesk
HELPDESK_KEY=
CANDIDATE_EMAIL=
CANDIDATE_NAME=

# Model: any OpenAI-compatible chat API. Groq is shown.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# For reasoning models such as gpt-oss: low, medium or high. Empty means the provider's default.
# low keeps hidden reasoning short, which saves tokens on a free plan.
LLM_REASONING_EFFORT=low
